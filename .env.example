# ==============================================================================
# CONFIGURATION GLOBALE - EXEMPLE DE VARIABLES D'ENVIRONNEMENT
# Copiez ce fichier sous le nom '.env' et remplissez-le avec vos propres valeurs.
# ==============================================================================

# Environnement d'exécution (development, testing, production)
ENV=development

# Niveau de journalisation globale (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# CLÉS D'API FINANCIÈRES
# ------------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=
QUANDL_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ------------------------------------------------------------------------------
# PARAMÈTRES DE LA BASE DE DONNÉES
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quant_db
DB_USER=postgres
DB_PASSWORD=

# ------------------------------------------------------------------------------
# PARAMÈTRES FINANCIERS PAR DÉFAUT — CONTEXTE BRVM / UEMOA
# ------------------------------------------------------------------------------
DEFAULT_TICKER=SNTS.SN       # Ticker par défaut (Sonatel)
DEFAULT_BENCHMARK=BRVMC      # Indice de référence : BRVM Composite
RISK_FREE_RATE=0.055         # Taux sans risque OAT UEMOA (~5.5%)
