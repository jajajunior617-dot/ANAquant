# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Caches de développement
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# Environnement Virtuel
ana_env/
data_env/
venv/
.venv/
env/

